# ========================
# SmartRent — Environment Variables
# Copy this file to .env and fill in the values
# ========================

# App
APP_NAME="SmartRent"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# API
API_V1_STR=/api/v1
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://smartrent:smartrent123@localhost:5432/smartrent
DATABASE_URL_SYNC=postgresql://smartrent:smartrent123@localhost:5432/smartrent

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (Cloudflare R2 / AWS S3)
S3_BUCKET_NAME=smartrent-uploads
S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=auto

# OCR (Google Cloud Vision)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-vision.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Payment Webhook (SePay / Casso)
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
CASSO_WEBHOOK_SECRET=your-casso-webhook-secret
PAYMENT_GATEWAY=sepay  # sepay | casso | momo

# Zalo ZNS Notification
ZALO_OA_ACCESS_TOKEN=your-zalo-oa-token
ZALO_TEMPLATE_INVOICE_ID=your-invoice-template-id
ZALO_TEMPLATE_PAID_ID=your-paid-template-id
ZALO_TEMPLATE_TICKET_ID=your-ticket-template-id

# VietQR
VIETQR_BANK_CODE=MB  # MBBank, VCB, TCB, etc.
VIETQR_ACCOUNT_NUMBER=your-account-number
VIETQR_ACCOUNT_NAME=CHU TRO SMARTRENT

# Firebase FCM (push notification)
FIREBASE_CREDENTIALS_JSON=/app/credentials/firebase.json

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://smartrent.vn"]
